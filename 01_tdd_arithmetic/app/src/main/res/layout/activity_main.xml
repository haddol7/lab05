<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="40dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textAppearance="@android:style/TextAppearance.Material.Title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/expression_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|bottom"
        android:paddingBottom="8dp"
        android:text="@string/expression_initial"
        android:textAppearance="@android:style/TextAppearance.Material.Body1"
        android:textColor="@color/display_secondary" />

    <TextView
        android:id="@+id/display_text"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:ellipsize="start"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:text="@string/display_initial"
        android:textColor="@color/display_text"
        android:textSize="48sp"
        android:textStyle="bold" />

    <LinearLayout style="@style/CalculatorRow">

        <Button
            android:id="@+id/button_clear"
            style="@style/CalculatorFunctionButton"
            android:text="@string/button_clear" />

        <Button
            android:id="@+id/button_backspace"
            style="@style/CalculatorFunctionButton"
            android:text="@string/button_backspace" />

        <Button
            android:id="@+id/button_sign"
            style="@style/CalculatorFunctionButton"
            android:text="@string/button_sign" />

        <Button
            android:id="@+id/button_divide"
            style="@style/CalculatorOperatorButton"
            android:text="@string/button_divide" />

    </LinearLayout>

    <LinearLayout style="@style/CalculatorRow">

        <Button
            android:id="@+id/button_7"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_7" />

        <Button
            android:id="@+id/button_8"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_8" />

        <Button
            android:id="@+id/button_9"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_9" />

        <Button
            android:id="@+id/button_multiply"
            style="@style/CalculatorOperatorButton"
            android:text="@string/button_multiply" />

    </LinearLayout>

    <LinearLayout style="@style/CalculatorRow">

        <Button
            android:id="@+id/button_4"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_4" />

        <Button
            android:id="@+id/button_5"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_5" />

        <Button
            android:id="@+id/button_6"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_6" />

        <Button
            android:id="@+id/button_subtract"
            style="@style/CalculatorOperatorButton"
            android:text="@string/button_subtract" />

    </LinearLayout>

    <LinearLayout style="@style/CalculatorRow">

        <Button
            android:id="@+id/button_1"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_1" />

        <Button
            android:id="@+id/button_2"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_2" />

        <Button
            android:id="@+id/button_3"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_3" />

        <Button
            android:id="@+id/button_add"
            style="@style/CalculatorOperatorButton"
            android:text="@string/button_add" />

    </LinearLayout>

    <LinearLayout style="@style/CalculatorRow">

        <Button
            android:id="@+id/button_0"
            style="@style/CalculatorZeroButton"
            android:text="@string/button_0" />

        <Button
            android:id="@+id/button_decimal"
            style="@style/CalculatorNumberButton"
            android:text="@string/button_decimal" />

        <Button
            android:id="@+id/button_equals"
            style="@style/CalculatorEqualsButton"
            android:text="@string/button_equals" />

    </LinearLayout>

</LinearLayout>
