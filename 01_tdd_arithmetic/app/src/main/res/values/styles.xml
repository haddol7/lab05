<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
    </style>

    <style name="CalculatorRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalculatorButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CalculatorNumberButton" parent="CalculatorButton">
        <item name="android:backgroundTint">@color/number_button</item>
        <item name="android:textColor">@color/number_button_text</item>
    </style>

    <style name="CalculatorZeroButton" parent="CalculatorNumberButton">
        <item name="android:layout_weight">2</item>
    </style>

    <style name="CalculatorFunctionButton" parent="CalculatorButton">
        <item name="android:backgroundTint">@color/function_button</item>
        <item name="android:textColor">@color/function_button_text</item>
    </style>

    <style name="CalculatorOperatorButton" parent="CalculatorButton">
        <item name="android:backgroundTint">@color/operator_button</item>
        <item name="android:textColor">@color/operator_button_text</item>
    </style>

    <style name="CalculatorEqualsButton" parent="CalculatorOperatorButton" />
</resources>
